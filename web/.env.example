# Local mode: base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub mode: set owner/repo to run the agent through GitHub Actions instead of a
# local API (this is what the GitHub Pages build uses). The browser dispatches the
# research-digest workflow and polls status files committed to the "status" branch.
# NEXT_PUBLIC_GITHUB_REPO=akhiil03/sample-research-agent
# NEXT_PUBLIC_DEFAULT_MODEL=gemini-3.5-flash-lite

# GitHub Pages subpath (set during the Pages build, leave empty locally).
# NEXT_PUBLIC_BASE_PATH=/sample-research-agent
