# Required for real runs (get one at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Optional: override the model. "openrouter/free" auto-routes to a free,
# tool-calling model; any OpenRouter model id works here.
AGENT_MODEL=openrouter/free

# Optional: attribution headers shown on your OpenRouter dashboard
OPENROUTER_APP_TITLE=sample-research-agent
# OPENROUTER_APP_URL=https://github.com/OWNER/sample-research-agent

# Optional: run the agent fully offline with a scripted model and fake tools.
# AGENT_FAKE_MODEL=1

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
