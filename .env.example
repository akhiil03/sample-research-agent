# Required for real runs — create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Provider: "google" (Gemini API, free tier) or "openrouter" (needs OPENROUTER_API_KEY)
AGENT_PROVIDER=google

# Optional: model override. Recommended for new projects: gemini-3.5-flash-lite or
# gemini-3.8-flash. gemini-2.5-flash and gemini-2.5-flash-lite are also free tier.
# OpenRouter users: any OpenRouter model id, e.g. openrouter/free (requires OPENROUTER_API_KEY).
AGENT_MODEL=gemini-3.5-flash-lite

# Optional: attribution header shown on your OpenRouter dashboard (openrouter provider only)
# OPENROUTER_APP_TITLE=sample-research-agent

# Optional: run the agent fully offline with a scripted model and fake tools.
# AGENT_FAKE_MODEL=1

# Optional: comma-separated browser origins allowed to call the API.
# Defaults include localhost:3000 and the GitHub Pages origin.
# WEB_ORIGIN=http://localhost:3000

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
